{
  "name": "holamotor-taller",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"ng serve --host 0.0.0.0 --port 4200\" \"cross-env DATA_DIR=./data node --env-file-if-exists=.env server/index.js\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "server": "cross-env DATA_DIR=./data node --env-file-if-exists=.env server/index.js",
    "start:prod": "ng build && cross-env DATA_DIR=./data node --env-file-if-exists=.env server/index.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@types/qrcode": "^1.5.6",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tesseract.js": "^5.1.0",
    "tslib": "^2.6.0",
    "webpack": "^5.96.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "overrides": {
    "tar": "^7.5.21",
    "uuid": "^11.1.1",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
