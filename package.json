{
  "name": "holamotor-taller",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"ng serve --host 0.0.0.0 --port 4200\" \"cross-env DATA_DIR=./data node server/index.js\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
