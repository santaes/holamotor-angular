# HolaMotor Server Configuration

# Server settings
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
HOLAMOTOR_LANG=es

# Google Calendar OAuth 2.0 Credentials
# Create credentials at https://console.cloud.google.com/apis/credentials
# Ensure the authorized redirect URI in GCP console matches GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/calendar/callback
